# Normalize line endings to LF on checkin
* text=auto eol=lf

# Scripts
*.bat   text eol=crlf
gradlew text eol=lf

# Source / config
*.kt   text
*.kts  text
*.xml  text
*.pro  text
*.md   text
*.yml  text
*.yaml text

# Binary assets
*.jar      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.keystore binary
*.jks      binary
